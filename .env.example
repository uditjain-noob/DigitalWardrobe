# Copy to .env and fill in for local development (`npm run dev`).
# The test harness (`npm test`) does not read this file — see
# vitest.config.ts and scripts/test-db.sh for its fixed test values.

# Postgres connection string. Matches docker-compose.yml's `postgres` service.
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5432/wardrobe

# S3-compatible object storage — MinIO locally (docker-compose.yml), Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wardrobe
S3_ACCESS_KEY_ID=wardrobe
S3_SECRET_ACCESS_KEY=wardrobe12345

# Resend API key, for email verification and password reset.
RESEND_API_KEY=

# Public URL the app is served from.
APP_URL=http://localhost:3000

# Name of the session cookie.
SESSION_COOKIE_NAME=wardrobe_session

# Per-account caps (NFR-7.3) — configurable without a code change.
MAX_ITEMS_PER_ACCOUNT=1000
MAX_STORAGE_BYTES_PER_ACCOUNT=5368709120

# Comma-separated list of emails exempt from the caps above (e.g. the author's own account).
CAP_EXEMPT_EMAILS=
